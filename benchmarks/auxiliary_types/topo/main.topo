// 09_auxiliary_types — Runtime auxiliary type demonstration
// Demonstrates: topo::array, topo::span, topo::slot usage

using int = std::cpp17::int;
using float = std::cpp17::float;

namespace aux {

  public:
    int sum_array(int* data, int size);
    float average(float* data, int size);
    int find_or_default(int* data, int size, int target, int fallback);
}
