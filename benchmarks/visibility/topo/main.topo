// 01_hello_visibility — Visibility basics
// Demonstrates: three-level visibility, nested namespaces,
// C++ and Rust style declarations, const, reference, pointer

using int = std::cpp17::int;

namespace calc::core {

  public:
    int add(int a, int b);
    subtract(int a, int b) -> int;
    const int& get_last_result();

  protected:
    void log_operation(const int result);

  private:
    void reset_state();

    namespace impl {
      private:
        void set(int* out, int val);
    }
}
