// 16_ownership — Ownership qualifier optimization
// Demonstrates: owned/shared/weak qualifiers driving IndirectionPass

using int = std::cpp17::int;

std::import("scene.h", Node);
std::import("scene.h", Texture);

namespace scene {
  public:
    run_test() -> int;

  protected:
    process_owned(owned Node node) -> int;
    process_shared(shared Texture tex) -> int;
    observe_weak(weak Texture tex) -> int;
}
